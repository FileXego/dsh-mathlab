    {
      "id": "natural-transformation",
      "title": "A natural transformation to an idempotent",
      "title_zh": "到幂等态射的自然变换",
      "field": "category",
      "panel": "category",
      "description": "F sends f to id_X while G sends it to the idempotent e; choosing both components to be e makes the naturality square commute (e ∘ e = e ∘ id).",
      "description_zh": "F 把 f 映为 id_X，G 把 f 映为幂等元 e；取两个分量均为 e 时自然性方块交换（e ∘ e = e ∘ id）。",
      "action": {
        "op": "category.natural",
        "args": {
          "source": {
            "objects": [
              {
                "id": "A",
                "label": "A"
              },
              {
                "id": "B",
                "label": "B"
              }
            ],
            "morphisms": [
              {
                "id": "idA",
                "dom": "A",
                "cod": "A",
                "label": "id_A"
