    {
      "id": "small-category-laws",
      "title": "Validating a small category",
      "title_zh": "验证小范畴",
      "field": "category",
      "panel": "category",
      "description": "Check identity and associativity laws for the free arrow category A -> B.",
      "description_zh": "检验自由箭头范畴 A -> B 的恒等与结合律。",
      "action": {
        "op": "category.validate",
        "args": {
          "category": {
            "objects": [
              {
                "id": "A",
                "label": "A"
              },
              {
                "id": "B",
                "label": "B"
              }
            ],
            "morphisms": [
              {
                "id": "idA",
                "dom": "A",
                "cod": "A",
                "label": "id_A"
              },
              {
                "id": "idB",
                "dom": "B",
                "cod": "B",
                "label": "id_B"
              },
              {
                "id": "f",
                "dom": "A",
                "cod": "B",
                "label": "f"
              }
            ],
            "identities": [
              {
                "object": "A",
                "morphism": "idA"
              },
              {
                "object": "B",
                "morphism": "idB"
              }
            ],
            "compositions": [
              {
                "first": "idA",
                "second": "idA",
                "result": "idA"
              },
              {
                "first": "idA",
                "second": "f",
                "result": "f"
              },
              {
                "first": "f",
                "second": "idB",
                "result": "f"
              },
              {
                "first": "idB",
                "second": "idB",
                "result": "idB"
              }
            ]
          }
        }
      },
      "expect": "valid: 2 objects, 3 morphisms"
    },
