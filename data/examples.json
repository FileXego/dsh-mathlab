{
  "examples": [
    {
      "id": "gaussian-integral",
      "title": "Gaussian integral",
      "title_zh": "高斯积分",
      "field": "analysis",
      "panel": "compute",
      "description": "Evaluate the classic Gaussian integral with SymPy.",
      "description_zh": "用 SymPy 计算经典高斯积分。",
      "action": {
        "op": "calc.integrate",
        "args": {
          "expr": "exp(-x**2)",
          "var": "x",
          "lower": "-oo",
          "upper": "oo"
        }
      },
      "expect": "sqrt(pi)"
    },
    {
      "id": "dirichlet-integral",
      "title": "Dirichlet integral",
      "title_zh": "狄利克雷积分",
      "field": "analysis",
      "panel": "compute",
      "description": "Integrate sin(x)/x over the positive half-line; the value is pi/2.",
      "description_zh": "在正半轴上积分 sin(x)/x，结果为 pi/2。",
      "action": {
        "op": "calc.integrate",
        "args": {
          "expr": "sin(x)/x",
          "var": "x",
          "lower": "0",
          "upper": "oo"
        }
      },
      "expect": "pi/2"
    },
    {
      "id": "sinc-limit",
      "title": "Fundamental limit sin(x)/x",
      "title_zh": "基本极限 sin(x)/x",
      "field": "analysis",
      "panel": "compute",
      "description": "The sinc function tends to 1 at zero; the engine returns the limit expression.",
      "description_zh": "sinc 函数在 0 处的极限为 1。",
      "action": {
        "op": "calc.limit",
        "args": {
          "expr": "sin(x)/x",
          "var": "x",
          "point": "0"
        }
      },
      "expect": "1"
    },
    {
      "id": "e-limit",
      "title": "Euler limit definition of e",
      "title_zh": "e 的欧拉极限定义",
      "field": "analysis",
      "panel": "compute",
      "description": "Show that (1 + 1/x)^x tends to Euler's number e as x tends to infinity.",
      "description_zh": "展示 (1 + 1/x)^x 当 x 趋于无穷时趋近欧拉数 e。",
      "action": {
        "op": "calc.limit",
        "args": {
          "expr": "(1 + 1/x)**x",
          "var": "x",
          "point": "oo"
        }
      },
      "expect": "E"
    },
    {
      "id": "exp-taylor",
      "title": "Taylor series of exp(x)",
      "title_zh": "exp(x) 的泰勒级数",
      "field": "analysis",
      "panel": "compute",
      "description": "Expand exp(x) around 0 up to order 6.",
      "description_zh": "将 exp(x) 在 0 处展开到 6 阶。",
      "action": {
        "op": "calc.series",
        "args": {
          "expr": "exp(x)",
          "var": "x",
          "point": "0",
          "order": 6
        }
      },
      "expect": "1 + x + x**2/2 + x**3/6 + x**4/24 + x**5/120"
    },
    {
      "id": "basel-problem",
      "title": "Basel problem",
      "title_zh": "巴塞尔问题",
      "field": "analysis",
      "panel": "compute",
      "description": "Sum the reciprocals of the squares; Euler's result is pi^2/6.",
      "description_zh": "平方倒数之和；欧拉结果为 pi^2/6。",
      "action": {
        "op": "calc.sum",
        "args": {
          "expr": "1/n**2",
          "var": "n",
          "lower": 1,
          "upper": "oo"
        }
      },
      "expect": "pi**2/6"
    },
    {
      "id": "geometric-series",
      "title": "Geometric series",
      "title_zh": "几何级数",
      "field": "analysis",
      "panel": "compute",
      "description": "Sum (1/2)^n from n = 0; the series converges to 2.",
      "description_zh": "从 n = 0 求 (1/2)^n 的和，级数收敛到 2。",
      "action": {
        "op": "calc.sum",
        "args": {
          "expr": "1/2**n",
          "var": "n",
          "lower": 0,
          "upper": "oo"
        }
      },
      "expect": "2"
    },
    {
      "id": "harmonic-oscillator",
      "title": "Harmonic oscillator ODE",
      "title_zh": "谐振子常微分方程",
      "field": "analysis",
      "panel": "compute",
      "description": "Solve y'' + y = 0 with y(0) = 1 and y'(0) = 0; the solution is cos(x).",
      "description_zh": "求解 y'' + y = 0，初值 y(0)=1、y'(0)=0，解为 cos(x)。",
      "action": {
        "op": "calc.dsolve",
        "args": {
          "eq": "y'' + y = 0",
          "func": "y",
          "var": "x",
          "ics": [
            {
              "x": 0,
              "y": 1
            },
            {
              "x": 0,
              "dy": 0
            }
          ]
        }
      },
      "expect": "y = cos(x)"
    },
