{
  "name": "dsh-mathlab",
  "version": "0.2.2",
  "private": false,
  "type": "module",
  "description": "MathLab — a graduate-level mathematics research workbench for DeepSeek Harness: symbolic computation, abstract algebra, category theory, mathematical logic, Lean 4, plotting and a searchable symbol atlas.",
  "license": "MIT",
  "author": {
    "name": "FileXego",
    "email": "2013266284@qq.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FileXego/dsh-mathlab.git"
  },
  "homepage": "https://github.com/FileXego/dsh-mathlab#readme",
  "bugs": {
    "url": "https://github.com/FileXego/dsh-mathlab/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "math",
    "mathematics",
    "sympy",
    "lean4",
    "latex",
    "live-stage",
    "abstract-algebra",
    "category-theory",
    "logic",
    "plotting"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "scripts": {
    "build": "node build-client.mjs",
    "setup:python": "node scripts/install-python-deps.mjs",
    "test:stage": "node --test scripts/test-stage.mjs",
    "test:engine": "python -m unittest discover -s engine/tests -v",
    "test": "node --test scripts/test-stage.mjs scripts/test-bridge.mjs && node scripts/test-http.mjs && node scripts/test-examples.mjs",
    "ci": "node build-client.mjs && node --test scripts/test-stage.mjs scripts/test-bridge.mjs && node scripts/test-http.mjs && node scripts/test-examples.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "engine",
    "data",
    "assets",
    "scripts",
    "docs",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "NOTICE.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
